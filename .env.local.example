# Copy this file to .env.local and fill in real values there.
# .env.local is git-ignored — never commit real secrets.
#
# Rule of thumb: only NEXT_PUBLIC_* variables are sent to the browser.
# Everything else is read exclusively in server code (Route Handlers,
# Server Components, middleware) and must stay that way — see
# docs/SECURITY.md "Secrets" for what happens if this rule is broken.

# --- Public (safe to expose to the browser) ---

# Supabase project URL and anon key. The anon key is *designed* to be public
# — it can only do what Row Level Security policies allow. It is not a secret
# despite the name; the service role key below is the one that must stay
# server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — defaults to same-origin "/api" if unset (see lib/api.ts).
NEXT_PUBLIC_API_BASE_URL=

# --- Server-only secrets (never prefix these with NEXT_PUBLIC_) ---

# Bypasses Row Level Security entirely. Used only in lib/supabase/admin.ts,
# which is itself only ever imported from Route Handlers / server code —
# never from a Client Component. Treat this like a database root password.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for the AI shopping assistant (app/api/assistant).
ANTHROPIC_API_KEY=

# Shared secret Route Handlers under app/api/internal/* check against a
# request header before running scheduled/ingestion-triggered work (see
# lib/server/auth.ts:assertInternalRequest). Generate a long random string.
INTERNAL_CRON_SECRET=

# --- Affiliate network credentials (ingestion connectors — not called by
# this web app directly; documented here because affiliate_configurations
# rows reference these names via env_var_prefix, per the affiliate
# architecture in the platform doc. Connector implementations are a
# separate, later piece of work.) ---
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
ADMITAD_CLIENT_ID=
ADMITAD_CLIENT_SECRET=
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=

# --- Notifications ---

# Transactional email provider. Both must be set for email delivery to
# happen at all; without them the sender records deliveries as pending and
# System Health reports email as unconfigured, rather than silently
# dropping messages.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# Signs one-click unsubscribe links (HMAC). Generate a long random string.
# Falls back to the service-role key if unset, but a dedicated secret is
# strongly preferred: rotating the service-role key to revoke unsubscribe
# links would take the whole application down.
NOTIFICATION_TOKEN_SECRET=

# Absolute public URL, used to build links inside emails. Without it the
# sender falls back to the request origin, which is wrong when invoked by a
# scheduler rather than a browser.
NEXT_PUBLIC_SITE_URL=

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
# Sending is NOT implemented yet — see lib/notifications/push.ts.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
