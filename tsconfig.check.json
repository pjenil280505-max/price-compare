{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "esnext"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "paths": { "@/*": ["./*"] },
    "types": []
  },
  "include": ["lib/connectors/**/*.ts", "lib/server/**/*.ts", "lib/types.ts", "lib/utils.ts"],
  "exclude": ["node_modules"]
}
