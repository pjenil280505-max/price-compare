{
  "name": "price-compare-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable UI component library for the price-comparison platform. Components are presentational and receive data via props only \u2014 data fetching lives in lib/api.ts and the pages that call it.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-all.mjs",
    "typecheck:server": "tsc -p tsconfig.check.json",
    "test:watch": "node scripts/test-all.mjs",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile-android"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "framer-motion": "^11.11.0",
    "recharts": "^2.13.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-select": "^2.1.2",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "lucide-react": "^0.454.0",
    "next-themes": "^0.4.3",
    "zod": "^3.23.8",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.46.1",
    "@anthropic-ai/sdk": "^0.32.1",
